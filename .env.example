# Copy to .env for the API and frontend/.env.local for the browser.
DATABASE_URL=sqlite:///./opportunityos.db
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional legacy Supabase tokens (backend only). Never commit real values.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# app_system hub. Backend: INFRA_HUB_URL must equal the hub's INFRA_PUBLIC_URL; INFRA_APP_ID = the app id on the hub.
INFRA_HUB_URL=
INFRA_APP_ID=
DEV_AUTH_BYPASS=
DEV_USER_ID=
DEV_USER_EMAIL=
# Frontend (frontend/.env.local). INFRA_SECRET_KEY is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_INFRA_URL=
NEXT_PUBLIC_INFRA_PUBLISHABLE_KEY=
INFRA_SECRET_KEY=
APP_URL=http://localhost:3002
API_URL=http://localhost:8000/api/v1
