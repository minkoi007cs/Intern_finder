# ==============================================================================
# Intern Finder (Backend) Environment Variables
# ==============================================================================
# Database (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:your-password@your-host:5432/postgres?sslmode=require"

# Frontend Origin for CORS
FRONTEND_ORIGIN="https://intern.minkoi.org,http://localhost:3000"

# Supabase Auth Integration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_AUDIENCE="authenticated"

# app_system hub — backend (repo root .env or apps/api/.env)
# INFRA_HUB_URL must equal the hub's INFRA_PUBLIC_URL; INFRA_APP_ID is this app's id on the hub.
INFRA_HUB_URL=
INFRA_APP_ID=
# Local only: accepts the exact token "dev_token" when FRONTEND_ORIGIN is localhost.
DEV_AUTH_BYPASS=
DEV_USER_ID=
DEV_USER_EMAIL=

# app_system hub — web (apps/web/.env.local)
# INFRA_SECRET_KEY is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_INFRA_URL=
NEXT_PUBLIC_INFRA_PUBLISHABLE_KEY=
INFRA_SECRET_KEY=
APP_URL=http://localhost:3002
# Where the Next server reaches the FastAPI backend. The browser never calls it directly.
API_URL=http://localhost:8000/api/v1
